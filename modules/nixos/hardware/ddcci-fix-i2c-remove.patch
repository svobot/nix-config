From 638b35d7fede07d784c6f77ae9baae7489540226 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20Hamada?= <clementhamada@protonmail.com>
Date: Mon, 22 Jun 2026 17:30:21 +0200
Subject: [PATCH] Fix client device reference in driver i2c remove callback

---
 ddcci/ddcci.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ddcci/ddcci.c b/ddcci/ddcci.c
index 6b41eab..1452d20 100644
--- a/ddcci/ddcci.c
+++ b/ddcci/ddcci.c
@@ -1780,7 +1780,7 @@ static int ddcci_remove(struct i2c_client *client)
 
 	mutex_lock(&drv_data->lock);
 	while (1) {
-		dev = bus_find_device(&ddcci_bus_type, NULL, client,
+		dev = bus_find_device(&ddcci_bus_type, NULL, &client->dev,
 				      ddcci_remove_helper);
 		if (!dev)
 			break;
